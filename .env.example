# Server port. The app listens here; use 3001 to avoid clashing with other projects.
PORT=3001

# Node environment: development | production
NODE_ENV=development

# Maximum timetable upload size in megabytes.
MAX_UPLOAD_MB=10

# Ports tried in order if PORT is already in use. Leave empty to disable fallback.
FALLBACK_PORTS=3002,3003,3004

# Authentication.
#   AUTH_REQUIRED=false  sign-in is optional; the demo timetable stays browsable
#   AUTH_REQUIRED=true   anonymous API calls get 401 and pages redirect to /login
AUTH_REQUIRED=false
SESSION_SECRET=change-me-in-production
SESSION_HOURS=12
# Password shared by every demo account. Change it and the on-screen hint disappears.
DEMO_PASSWORD=tecsub123

# ---------------------------------------------------------------------------
# Neon PostgreSQL (optional)
# ---------------------------------------------------------------------------
# With DATABASE_URL set, the timetable is stored in PostgreSQL: tables are
# created if missing and seeded with the demo data when empty. Without it the
# app runs on the bundled in-memory demo dataset exactly as before — every
# feature except saving timetable edits keeps working.
#
# Copy this file to .env and paste your own connection string. .env is
# git-ignored: never commit a real connection string, and never paste one into
# a chat, an issue or a screenshot. If one leaks, reset the password in the
# Neon console.
#
# Neon shows the string on the project dashboard. It looks like:
#   postgresql://<user>:<password>@<endpoint>.neon.tech/<database>?sslmode=require
DATABASE_URL=

# Connection pool size and connect timeout.
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=10000

# Insert the demo dataset at startup when the timetable table is empty.
# Existing rows are never touched, and demo records are never duplicated.
DB_AUTO_SEED=true

# ---------------------------------------------------------------------------
# PDF.co document extraction (optional)
# ---------------------------------------------------------------------------
# Enables reading a timetable out of a PDF or an image (.pdf .png .jpg .jpeg
# .webp). The file is uploaded to PDF.co, its table structure is extracted, and
# the result runs through exactly the same normalizer and validator that Excel
# and CSV imports use.
#
# Without a key, PDF/image upload reports that extraction is not configured and
# every other import route keeps working. Get a key from https://pdf.co.
#
# Copy this file to .env and paste your key there. .env is git-ignored: never
# commit a real key, never paste one into a chat or a screenshot. If one leaks,
# rotate it in the PDF.co dashboard.
PDFCO_API_KEY=

# API base URL and request timeout. Defaults suit pdf.co; override only if you
# are pointing at a compatible endpoint.
PDFCO_BASE_URL=https://api.pdf.co/v1
PDFCO_TIMEOUT_MS=120000
