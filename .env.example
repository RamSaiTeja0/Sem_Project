# Server port. The app listens here; use 3001 to avoid clashing with other projects.
PORT=3001

# Node environment: development | production
NODE_ENV=development

# Maximum timetable upload size in megabytes.
MAX_UPLOAD_MB=10

# Ports tried in order if PORT is already in use. Leave empty to disable fallback.
FALLBACK_PORTS=3002,3003,3004

# Authentication.
#   AUTH_REQUIRED=false  sign-in is optional; the demo timetable stays browsable
#   AUTH_REQUIRED=true   anonymous API calls get 401 and pages redirect to /login
AUTH_REQUIRED=false
SESSION_SECRET=change-me-in-production
SESSION_HOURS=12
# Password shared by every demo account. Change it and the on-screen hint disappears.
DEMO_PASSWORD=tecsub123
